---
// Monochrome social glyphs from simple-icons (CC0), inlined at build time so
// nothing ships to the client. The link carries the accessible name, so the
// glyph itself is decorative.
import {
  siBluesky,
  siDiscord,
  siFarcaster,
  siGithub,
  siInstagram,
  siMastodon,
  siReddit,
  siTelegram,
  siTiktok,
  siX,
  siYoutube,
  type SimpleIcon,
} from 'simple-icons';
import { SOCIAL_LABELS, type SocialKey } from '../content.config';

interface Props {
  network: SocialKey;
  size?: number;
}

const { network, size = 18 } = Astro.props;

// Named imports rather than an indexed namespace, so the build does not have to
// parse all 3400 icons. LinkedIn has no entry: simple-icons dropped it over a
// trademark request.
const ICONS: Partial<Record<SocialKey, SimpleIcon>> = {
  instagram: siInstagram,
  x: siX,
  bluesky: siBluesky,
  farcaster: siFarcaster,
  mastodon: siMastodon,
  tiktok: siTiktok,
  youtube: siYoutube,
  reddit: siReddit,
  telegram: siTelegram,
  discord: siDiscord,
  github: siGithub,
};

/**
 * What a network without a glyph is set in, on the same square as the others:
 * the short form it is read as, not a redrawn logo. Brand colours are the ones
 * simple-icons carries for the networks it does ship.
 */
const MARKS: Partial<Record<SocialKey, { text: string; hex: string }>> = {
  linkedin: { text: 'in', hex: '0A66C2' },
};

const icon = ICONS[network];
const mark = MARKS[network];
---

{
  icon ? (
    <svg
      class="icon"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      aria-hidden="true"
      style={`--brand: #${icon.hex}`}
    >
      <path d={icon.path} />
    </svg>
  ) : mark ? (
    <span class="mark" aria-hidden="true" style={`--brand: #${mark.hex}; --mark-size: ${size}px`}>
      {mark.text}
    </span>
  ) : (
    <span class="links__text">{SOCIAL_LABELS[network]}</span>
  )
}
