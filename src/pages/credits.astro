---
import Base from '../layouts/Base.astro';
import { ARCHIVE_SOURCE, ORG_NAME, REPOSITORY, organization } from '../data/site';
import { getMaintainer } from '../lib/maintainer';

const maintainer = await getMaintainer(Astro.site);

const description = `What this site is, who maintains it, and how to contribute to the directory of the ${ORG_NAME}.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'About this site',
  url: new URL('/credits', Astro.site).href,
  description,
  about: organization(Astro.site),
  maintainer: maintainer.node,
  isBasedOn: ARCHIVE_SOURCE,
};
---

<Base title="About this site" description={description} schema={schema}>
  <div class="wrap section--tight">
    <h1 class="lede lede--small">About this site</h1>

    <div class="prose mt-3">
      <p>
        This is the website of the {ORG_NAME}, a community of generative artists
        founded in 2019 as a Parisian salon. It keeps a public directory of the
        members and links to their work.
      </p>
      <p>
        It was rebuilt in 2026 by <a href={maintainer.website} rel="me noopener" target="_blank"
          >{maintainer.name}</a
        >, a member of the club, with the agreement of the club and of its
        previous maintainer.
      </p>
      <p>
        Membership is by co-option: an artist belongs to the club when an
        existing member brings them in, and only members are listed here.
      </p>
      <p>
        The site is open source and every artist is a single Markdown file, so
        fixing your entry or adding an artwork is a small pull request. Everyone
        is welcome to contribute on <a href={REPOSITORY} rel="noopener" target="_blank"
          >the repository</a
        >.
      </p>
    </div>
  </div>
</Base>
