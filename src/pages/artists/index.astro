---
import Base from '../../layouts/Base.astro';
import ArtistLinks from '../../components/ArtistLinks.astro';
import { getCollection } from 'astro:content';
import { absolute, artistPath } from '../../lib/url';
import { letterFor, personId, sortedByName } from '../../lib/artist';
import { ORG_NAME, organization, websiteId } from '../../data/site';

const artists = await getCollection('artists');

const sorted = sortedByName(artists);

const groups = new Map<string, typeof artists>();
for (const artist of sorted) {
  const letter = letterFor(artist.data.name);
  groups.set(letter, [...(groups.get(letter) ?? []), artist]);
}

const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const anchorId = (letter: string) => (letter === '#' ? 'other' : letter);

// Letters with no member stay visible but greyed out, so the index never moves.
const index = [...(groups.has('#') ? ['#'] : []), ...LETTERS].map((letter) => ({
  letter,
  id: anchorId(letter),
  present: groups.has(letter),
}));

const sections = [...groups].map(([letter, members]) => ({
  letter,
  id: anchorId(letter),
  members,
}));

const description = `The ${artists.length} members of the ${ORG_NAME}, with links to their work.`;

const url = absolute('/artists', Astro.site);

// The list is the point of this page, so it is declared as its main entity, in
// the order it is read. Each member is named against the `@id` their own page
// publishes, and nothing more: the id is that page's URL, so repeating the URL
// beside it would ship every member's address twice for no reader.
const members = sorted.map((artist, position) => ({
  '@type': 'ListItem',
  position: position + 1,
  item: {
    '@type': 'Person',
    '@id': personId(artist, Astro.site),
    name: artist.data.name,
  },
}));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${url}#page`,
      url,
      name: 'Artists',
      description,
      isPartOf: { '@id': websiteId(Astro.site) },
      about: organization(Astro.site),
      mainEntity: { '@id': `${url}#directory` },
    },
    {
      '@type': 'ItemList',
      '@id': `${url}#directory`,
      name: `Members of the ${ORG_NAME}`,
      numberOfItems: members.length,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: members,
    },
  ],
};
---

<Base title="Artists" description={description} schema={schema}>
  <div class="wrap">
    <section class="section--tight">
      <h1 class="lede lede--small">Artists</h1>
      <p class="prose mt-2">
        A directory of the {ORG_NAME}: {artists.length} generative artists listed so far.
      </p>
    </section>

    <nav class="index" aria-label="Jump to letter">
      {
        index.map((entry) =>
          entry.present ? (
            <a href={`#${entry.id}`}>{entry.letter}</a>
          ) : (
            <span aria-hidden="true">{entry.letter}</span>
          ),
        )
      }
    </nav>

    {
      sections.map((entry) => (
        <section class="letter" id={entry.id}>
          <h2 class="letter__mark" aria-label={`Artists starting with ${entry.letter}`}>
            {entry.letter}
          </h2>
          <div>
            {entry.members.map((artist) => (
              <article class="row">
                <div>
                  <p class="row__name">
                    <a href={artistPath(artist.id)}>{artist.data.name}</a>
                  </p>
                  {artist.data.tagline && <p class="row__tagline">{artist.data.tagline}</p>}
                </div>
                <ArtistLinks website={artist.data.website} socials={artist.data.socials} compact />
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>
